# LLM provider: nvidia or groq
LLM_PROVIDER=nvidia

# NVIDIA (build.nvidia.com): required when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_THINKING=0
NVIDIA_MEDIUM_EFFORT=0
# set very high for NVIDIA (it limits requests/min, not tokens/min)
LLM_TPM_LIMIT=10000000
LLM_MAX_OUTPUT_TOKENS=1500

# Groq: required when LLM_PROVIDER=groq (keep LLM_TPM_LIMIT=7000 then)
GROQ_API_KEY=

# run security, bugs and conventions at the same time
AGENT_PARALLEL=0

# MCP server of the pr-reviewer (Spring) app
MCP_URL=http://localhost:8081/mcp